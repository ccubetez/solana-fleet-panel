{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Solana Fleet Panel",
  "version": "1.0.0",
  "identifier": "com.solanafleet.panel",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Solana Fleet Panel",
        "width": 1400,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 700,
        "url": "http://127.0.0.1:3777",
        "visible": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../resources/node": "node",
      "../resources/app": "fleet-app"
    },
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "11.0" },
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
