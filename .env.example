# Solana Fleet Panel — environment
# Copy to .env and fill in your own Helius RPC key (https://helius.dev).
# The .env file is gitignored — never commit it.

# Mainnet RPC (required for CLUSTER=mainnet)
HELIUS_MAINNET=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY

# Devnet RPC (used when CLUSTER=devnet; falls back to public api.devnet.solana.com)
RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY
